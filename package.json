{
  "name": "kurio-nft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:demo": "tsc -b && vite build --mode e2e",
    "typecheck": "tsc -b && tsc -p tsconfig.e2e.json",
    "mocks:selftest": "node --import ./scripts/register-loader.mjs scripts/mock-selftest.mjs",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:report": "playwright show-report",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.8",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "axios": "^1.21.1",
    "decimal.js": "^10.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "lighthouse": "^12.6.0",
    "chrome-launcher": "^1.1.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

